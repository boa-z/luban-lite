Import('AIC_ROOT')
Import('PRJ_KERNEL')
from building import *

cwd = GetCurrentDir()
src = Glob('*.c')
src = Glob('image/*.c')
if not GetDepend('AIC_IN_SUSPEND_ENV'):
    src += Glob('partition/*.c')
src += Glob('private_param/*.c')
if not GetDepend('AIC_IN_SUSPEND_ENV'):
    if not GetDepend('LPKG_USING_ZLIB'):
        src += Glob('crc32/*.c')
if not GetDepend('AIC_IN_SUSPEND_ENV'):
    src += Glob('utils/*.c', exclude=['utils/pinmux_utils.c'])
    if not GetDepend('AIC_CHIP_D33X_RT') and not GetDepend('AIC_CHIP_D33X_AP'):
        src += Glob('utils/pinmux_utils.c')
CPPPATH = [cwd + '/include', ]

group = DefineGroup('aic_driver_common', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
